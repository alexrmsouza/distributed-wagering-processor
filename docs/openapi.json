  "info": {
    "description": "HTTP contract for wallet, wagering, reconciliation, and operational endpoints.",
    "title": "Distributed Wagering Processor API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/docs": {
      "get": {
        "operationId": "getApiDocumentation",
        "responses": {
          "200": {
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Local HTML documentation"
          }
        },
        "summary": "Get self-contained local API documentation",
        "tags": [
          "Documentation"
        ]
      }
    },
    "/docs/openapi.json": {
      "get": {
        "operationId": "getOpenApiDocument",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "OpenAPI 3.1 document"
          }
        },
        "summary": "Get the deterministic OpenAPI document",
        "tags": [
          "Documentation"
        ]
      }
    },
    "/health/live": {
      "get": {
        "operationId": "getLiveness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "status": "ok"
                },
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                }
              }
            },
            "description": "Process is live"
          }
        },
        "summary": "Check process liveness",
        "tags": [
          "Operations"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "getReadiness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "checks": {
                    "database": {
                      "status": "up"
                    },
                    "sqs": {
                      "status": "up"
                    }
                  },
                  "status": "ready"
                },
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Dependencies are ready"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "At least one dependency is unavailable"
          }
        },
        "summary": "Check PostgreSQL and SQS readiness independently",
        "tags": [
          "Operations"
        ]
      }
    },
    "/metrics": {
      "get": {
        "operationId": "getPrometheusMetrics",
        "responses": {
          "200": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Prometheus metrics"
          }
        },
        "summary": "Get Prometheus text exposition",
        "tags": [
          "Operations"
        ]
